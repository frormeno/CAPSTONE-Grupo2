/**
 * Cliente de ejemplo para la API actual de SIGIOP-MOP.
 * Sin dependencias, credenciales, persistencia ni reintentos automÃ¡ticos.
 * Consultar ../../MANUAL_CONEXION_WEB.md antes de integrar escrituras.
 */
export class ApiError extends Error {
  constructor(message, { status = 0, code = "HTTP_ERROR" } = {}) {
    super(message);
    this.name = "ApiError";
    this.status = status;
    this.code = code;
  }
}

export function createApiClient({
  baseUrl = "https://sigiop-mop.onrender.com",
  timeoutMs = 30_000,
  fetchImpl = globalThis.fetch,
} = {}) {
  const base = new URL(baseUrl);
  const localHttp = base.protocol === "http:" &&
    ["localhost", "127.0.0.1", "[::1]"].includes(base.hostname);
  if ((base.protocol !== "https:" && !localHttp) || base.username ||
      base.password || base.pathname !== "/" || base.search || base.hash) {
    throw new Error("Usa el origen HTTPS del backend, sin /api, rutas ni credenciales. HTTP solo en localhost.");
  }
  if (typeof fetchImpl !== "function") throw new Error("Este entorno necesita fetch.");

  function url(path) {
    if (typeof path !== "string" || !path.startsWith("/") || path.startsWith("//")) {
      throw new Error("La ruta debe comenzar con una sola barra: /api/...");
    }
    const target = new URL(path, base);
    if (target.origin !== base.origin || target.hash) {
      throw new Error("La ruta debe pertenecer al backend y no contener fragmentos.");
    }
    return target.href;
  }

  async function request(path, {
    method = "GET", body, signal, timeoutMs: waitMs = timeoutMs,
  } = {}) {
    method = method.toUpperCase();
    if ((method === "GET" || method === "HEAD") && body !== undefined) {
      throw new Error("GET y HEAD no admiten un cuerpo JSON.");
    }
    if (!Number.isFinite(waitMs) || waitMs <= 0) throw new Error("El timeout debe ser positivo.");
    const target = url(path);
    const controller = new AbortController();
    let timedOut = false;
    const abort = () => controller.abort();
    if (signal?.aborted) abort();
    else signal?.addEventListener("abort", abort, { once: true });
    const timer = setTimeout(() => { timedOut = true; controller.abort(); }, waitMs);

    try {
      const response = await fetchImpl(target, {
        method,
        headers: body === undefined ? { Accept: "application/json" } : {
          Accept: "application/json", "Content-Type": "application/json",
        },
        body: body === undefined ? undefined : JSON.stringify(body),
        credentials: "omit",
        mode: "cors",
        cache: "no-store",
        signal: controller.signal,
      });
      const raw = await response.text();
      let data;
      try { data = raw ? JSON.parse(raw) : null; }
      catch {
        throw new ApiError(`El servidor devolviÃ³ una respuesta que no es JSON (HTTP ${response.status}).`, {
          status: response.status, code: "INVALID_RESPONSE",
        });
      }
      if (!response.ok) {
        const message = typeof data?.message === "string" ? data.message : `Error HTTP ${response.status}.`;
        throw new ApiError(message, { status: response.status });
      }
      return data;
    } catch (error) {
      if (error instanceof ApiError) throw error;
      if (controller.signal.aborted) {
        throw new ApiError(timedOut
          ? "Se agotÃ³ el tiempo de espera. Si estabas guardando, consulta el estado antes de repetir."
          : "Solicitud cancelada.", { code: timedOut ? "TIMEOUT" : "ABORTED" });
      }
      throw new ApiError("No se pudo conectar. Revisa la conexiÃ³n, la URL y CORS.", { code: "NETWORK_ERROR" });
    } finally {
      clearTimeout(timer);
      signal?.removeEventListener("abort", abort);
    }
  }

  return {
    url,
    request,
    get: (path, options = {}) => request(path, { ...options, method: "GET" }),
    post: (path, body, options = {}) => request(path, { ...options, method: "POST", body }),
    put: (path, body, options = {}) => request(path, { ...options, method: "PUT", body }),
    patch: (path, body, options = {}) => request(path, { ...options, method: "PATCH", body }),
    delete: (path, body, options = {}) => request(path, { ...options, method: "DELETE", body }),
  };
}

/** Base64 puro para las fotos: sin prefijo data:image/...;base64,. */
export function fileToBase64(file, maxBytes = 8 * 1024 * 1024) {
  if (!file || file.size === 0 || file.size > maxBytes) {
    return Promise.reject(new Error("Selecciona una fotografÃ­a de hasta 8 MiB."));
  }
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onerror = () => reject(new Error("No se pudo leer la fotografÃ­a."));
    reader.onload = () => {
      const value = String(reader.result);
      const separator = value.indexOf(",");
      if (separator < 0) reject(new Error("Formato de fotografÃ­a invÃ¡lido."));
      else resolve(value.slice(separator + 1));
    };
    reader.readAsDataURL(file);
  });
}

endstream
